# Database URLs (connected via Docker exposed port 5435)
DATABASE_URL=postgres://app_runtime:runtime_dev_password@127.0.0.1:5435/operations
MIGRATION_DATABASE_URL=postgres://app_migrator:migrator_dev_password@127.0.0.1:5435/operations
ADMIN_DATABASE_URL=postgres://postgres:postgres_dev_password@127.0.0.1:5435/operations
BACKUP_DATABASE_URL=postgres://app_backup:backup_dev_password@127.0.0.1:5435/operations

# Server & Client configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
COOKIE_SECRET=operations-under-pressure-cookie-secret-key-32chars

# Database Pool
POOL_MAX=10
WORKER_POOL_MAX=3

# Concurrency & Workflow
MERGE_MAX_GAP=10

# Outbox Worker Settings
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=1000

# WebSocket Limits
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=5000
WS_HEARTBEAT_INTERVAL_MS=25000
WS_SESSION_REVALIDATE_MS=30000

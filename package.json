{
  "name": "operations-under-pressure",
  "version": "1.0.0",
  "description": "Operations Under Pressure - Newtonite Engineering System",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "node src/api/server.js",
    "dev:worker": "node src/worker/worker.js",
    "dev:web": "vite --config web/vite.config.js web",
    "build:web": "vite build --config web/vite.config.js web",
    "migrate": "node src/db/migrator.js",
    "seed": "node src/db/seed.js",
    "backup": "node scripts/backup.js",
    "test": "vitest run --fileParallelism=false --testTimeout=30000",
    "test:concurrency": "vitest run test/concurrency.test.js --testTimeout=30000"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "fastify": "^5.2.1",
    "lucide-react": "^1.16.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
